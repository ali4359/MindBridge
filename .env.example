# Copy to .env and fill in your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Neo4j graph database (local Docker: docker run -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:community)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Active use-case profile (swap without code changes)
# USE_CASE_CONFIG=configs/mental_health.yaml
# USE_CASE_CONFIG=configs/legal.yaml
